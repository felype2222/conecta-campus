[Unit]
Description=Conecta Campus Flask/Gunicorn
After=network.target

[Service]
User=administrador
WorkingDirectory=/home/administrador/Documentos/do piaui para o mundo/app
Environment="SECRET_KEY=troque-esta-chave"
ExecStart=/home/administrador/Documentos/do piaui para o mundo/app/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
